# Copy to .env, edit, then load it into your shell before starting:
#   set -a && . ./.env && set +a && python -m sourcebound
# Every variable is optional. With none set, Sourcebound runs in free extractive mode.

# --- Server ---------------------------------------------------------------
SOURCEBOUND_HOST=127.0.0.1
SOURCEBOUND_PORT=8000
SOURCEBOUND_DB_PATH=data/sourcebound.db

# --- Limits ---------------------------------------------------------------
SOURCEBOUND_MAX_UPLOAD_MB=10
SOURCEBOUND_MAX_SOURCES=40
SOURCEBOUND_MAX_RUN_SECONDS=90
SOURCEBOUND_MAX_CONCURRENT_RUNS=4
SOURCEBOUND_RUNS_PER_MINUTE=6
# Delete sources and reports older than this many hours (0 = keep until deleted).
SOURCEBOUND_RETENTION_HOURS=0
# Allow users to add public web pages by URL.
SOURCEBOUND_ALLOW_URL_FETCH=true

# --- Optional AI model (any OpenAI-compatible Chat Completions API) -------
# none = free extractive mode; openai_compatible = enable "Write with AI model".
SOURCEBOUND_LLM_PROVIDER=none
# Examples:
#   Ollama (local, free):   http://localhost:11434/v1   model e.g. llama3.1
#   OpenAI:                 https://api.openai.com/v1    model e.g. gpt-4o-mini
#   Groq:                   https://api.groq.com/openai/v1
SOURCEBOUND_LLM_BASE_URL=
SOURCEBOUND_LLM_MODEL=
# Leave empty for local servers that need no key. Never commit a real key.
SOURCEBOUND_LLM_API_KEY=
SOURCEBOUND_LLM_TIMEOUT=45
SOURCEBOUND_LLM_MAX_CALLS=4
